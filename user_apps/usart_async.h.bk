#ifndef USART_ASYNC_H_
#define USART_ASYNC_H_

/*******************************************************************************
 *************************** Macros   *******************************
 ******************************************************************************/
// IF send and receive should happen continuously then both macros should be enabled
#define USE_SEND    ENABLE ///< Used to enable USART send
#define USE_RECEIVE ENABLE  ///< Used to enable USART receive




/*******************************************************************************
 ********************************   ENUMS   ************************************
 ******************************************************************************/
//Enum for different transmission scenarios
typedef enum {
  SL_USART_SEND_DATA,             ///< SL_USART_SEND_DATA
  SL_USART_RECEIVE_DATA,          ///< SL_USART_RECEIVE_DATA
  SL_USART_TRANSMISSION_COMPLETED,///< SL_USART_TRANSMISSION_COMPLETED
} usart_mode_enum_t;

typedef enum {
  BASIC_INFORMATION=1,
  STATE_INFORMATION,

  SENSOR_INFORMATION=5,
  SOFTWARE_VERIFICATION=6,
  WATER_DISCHARGE_AMOUNT=7,
  COMMAND_ID_MAX
} youngone_cmd_id_e;

typedef enum {
  NO_ERROR=0,
  CRC_FAILED,
  UNKNOWN_CMD,
  BAD_OARAM,
  DATA_LENGTH_ERROR,
  STX_ERROR,
  PRODUCT_CODE_ERROR,
  ERROR_CODE_MAX
} youngone_data_error_e;

#define YOUNGONE_HEAD_1  0xFF
#define YOUNGONE_HEAD_2  0x81


#define PRODUCT_NAME_POS  2
#define COMMAND_POS       8
#define DATA_LENGTH_POS   10
#define CHECKSUM_POS      12
#define PAYLOAD_START_POS       14

extern uint8_t water_flow_out_flag;
extern uint8_t water_flow_out_step;


// -----------------------------------------------------------------------------
// Prototypes
/***************************************************************************/ /**
 * USART example initialization function
 * Calendar clock is configured.
 * A deafult structure of datetime is builded and set as the current value of calendar
 * The value of calendar is fetched and displayed on serial console.
 * As per the macros are enabled, the example will run alarm, millisecond trigger
 * one second trigger, time conversion and clock calibration.
 * 
 * @param none
 * @return none
 ******************************************************************************/
void usart_async_init(void);
void set_usart_receive_data_callback(void);
void user_usart_receive_data_action(void);

int8_t youngone_receive_data_parser(uint8_t *receive_buff, const uint8_t receive_size);

uint8_t YT_T1C_data_parser(void);
void YT_T1C_data_response(uint8_t err_status);


void youngwon_receive_response(uint8_t cmd_ID, uint8_t err_code);
void youngwon_water_out_control_setup(uint8_t water_mode);
void youngwon_recipe_control_setup(void);
void youngwon_software_verification_initial(uint8_t init_cmd);

void youngwon_send_water_flow_out_control(void);


/***************************************************************************/ /**
 * Function will run continuously and will wait for trigger
 * 
 * @param none
 * @return none
 ******************************************************************************/
void usart_async_process_action(void);



#endif /* USART_ASYNC_H_ */
