 ***************************  Defines / Macros  ********************************
 ******************************************************************************/
#define USART_BUFFER_SIZE 256   // Data send and receive length
#define USART_BAUDRATE    9600 // Baud rate <9600-7372800>
// [FIX-1] NON_UC_DEFAULT_CONFIG 매크로 제거 - usart_async_init()에서 항상 명시적으로 설정한다.

/*******************************************************************************
 *************************** LOCAL VARIABLES   *******************************
 ******************************************************************************/
static uint8_t usart_data_in[USART_BUFFER_SIZE];
//static uint8_t usart_data_out[USART_BUFFER_SIZE];

static uint8_t usart_data_out[64];


volatile boolean_t usart_send_complete = false, usart_transfer_complete = false, usart_receive_complete = false;
//static boolean_t usart_begin_transmission = true;

/*******************************************************************************
 **********************  Local Function prototypes   ***************************
 ******************************************************************************/
void usart_callback_event(uint32_t event);
//static void compare_loop_back_data(void);
/*******************************************************************************
 **************************   GLOBAL VARIABLES   *******************************
 ******************************************************************************/
sl_usart_handle_t usart_handle;
usart_mode_enum_t current_mode = SL_USART_SEND_DATA;

uint8_t water_flow_out_flag = 0;
uint8_t water_flow_out_step = 0;


#define __DMB()
#define PRODUCT_NAME_POS 2
#define COMMAND_POS 8
#define DATA_LENGTH_POS 10
#define CHECKSUM_POS 12
#define PAYLOAD_START_POS 14
#define YOUNGONE_HEAD_1 0xFF
#define YOUNGONE_HEAD_2 0x81

static int got_cmd[64];
static int ngot=0;

int8_t CA_youngone_receive_data_parser(uint8_t *b, const uint16_t n){ got_cmd[ngot++]=b[COMMAND_POS]*1000+n; return NO_ERROR; }
// ---- 프로토콜 정의 ----------------------------------------------------------
#define YOUNGONE_HEADER_LEN        PAYLOAD_START_POS       // STX2+PCODE6+CMD1+ST1+LEN1+RSV1+CRC2 = 14

// Length 필드 의미 선택
//  1 : Length = 헤더 포함 전체 프레임 길이 (기존 코드 / 현재 제어보드 동작 기준)
//  0 : Length = payload 길이 (프로토콜 문서 2-1 기준)
#ifndef YOUNGONE_LEN_IS_TOTAL
#define YOUNGONE_LEN_IS_TOTAL      1
#endif

#if YOUNGONE_LEN_IS_TOTAL
#define YOUNGONE_FRAME_LEN(len_field)   ((uint16_t)(len_field))
#define YOUNGONE_FRAME_MAX              255u
#else
#define YOUNGONE_FRAME_LEN(len_field)   ((uint16_t)(len_field) + YOUNGONE_HEADER_LEN)
#define YOUNGONE_FRAME_MAX              (255u + YOUNGONE_HEADER_LEN)
#endif

// 송신 시 Length 필드에 넣을 값 (send_len = 헤더 포함 전체 길이)
#if YOUNGONE_LEN_IS_TOTAL
#define YOUNGONE_LEN_FIELD(send_len)    ((uint8_t)(send_len))
#else
#define YOUNGONE_LEN_FIELD(send_len)    ((uint8_t)((send_len) - YOUNGONE_HEADER_LEN))
#endif

uint16_t youngone_checksum_calculation(uint8_t *payload, uint16_t length);

#define YOUNGONE_RX_TIMEOUT_TICKS  4u                      // 50ms x 4 = 200ms 동안 진전 없으면 재동기

// ---- 링버퍼 (ISR: head 만 씀 / 스레드: tail 만 씀) --------------------------
#define RX_RING_SIZE   512u                                // 2의 거듭제곱
#define RX_RING_MASK   (RX_RING_SIZE - 1u)

static uint8_t           rx_ring[RX_RING_SIZE];
static volatile uint16_t rx_head = 0;
static volatile uint16_t rx_tail = 0;

// ---- 프레임 누적 버퍼 -------------------------------------------------------
static uint8_t  rx_acc[YOUNGONE_FRAME_MAX + 1];
static uint16_t rx_acc_len   = 0;
static uint8_t  rx_idle_tick = 0;

// ---- 디버그 통계 ------------------------------------------------------------
typedef struct {
  uint32_t frame_ok;
  uint32_t crc_err;
  uint32_t len_err;
  uint32_t pcode_err;
  uint32_t dispatch_err;
  uint32_t ring_overflow;
  uint32_t timeout_resync;
  uint32_t drop_bytes;
} youngone_rx_stat_t;

youngone_rx_stat_t youngone_rx_stat;

static inline void rx_ring_push_isr(uint8_t c)
{
  uint16_t next = (uint16_t)((rx_head + 1u) & RX_RING_MASK);

  if (next == rx_tail) {                 // full → 새 바이트 버림
    youngone_rx_stat.ring_overflow++;
    return;
  }
  rx_ring[rx_head] = c;
  __DMB();                               // 데이터 기록 후 head 갱신 순서 보장
  rx_head = next;
}

static inline bool rx_ring_pop(uint8_t *c)
{
  uint16_t tail = rx_tail;

  if (tail == rx_head) {
    return false;
  }
  *c = rx_ring[tail];
  __DMB();
  rx_tail = (uint16_t)((tail + 1u) & RX_RING_MASK);
  return true;
}

static void rx_acc_drop(uint16_t n)
{
  if (n >= rx_acc_len) {
    rx_acc_len = 0;
    return;
  }
  memmove(rx_acc, &rx_acc[n], rx_acc_len - n);
  rx_acc_len -= n;
}

// CRC 계산 시 checksum 필드는 0x0000 으로 간주 (문서 기준). 버퍼 원본은 복원한다.
static bool youngone_crc_ok(uint8_t *f, uint16_t frame_len)
{
  uint8_t  c0 = f[CHECKSUM_POS];
  uint8_t  c1 = f[CHECKSUM_POS + 1];
  uint16_t rx_crc = (uint16_t)c0 | ((uint16_t)c1 << 8);
  uint16_t calc;

  f[CHECKSUM_POS]     = 0;
  f[CHECKSUM_POS + 1] = 0;
  calc = youngone_checksum_calculation(f, frame_len);
  f[CHECKSUM_POS]     = c0;
  f[CHECKSUM_POS + 1] = c1;

  return (rx_crc == calc);
}

/*******************************************************************************
 * 누적 버퍼에서 완성된 프레임을 모두 꺼내 처리한다.
 ******************************************************************************/
static void youngone_framer_run(void)
{
  uint16_t i, frame_len;
  int8_t   ret;

  for (;;) {
    // 1) STX 탐색 ------------------------------------------------------------
    for (i = 0; (i + 1u) < rx_acc_len; i++) {
      if (rx_acc[i] == YOUNGONE_HEAD_1 && rx_acc[i + 1u] == YOUNGONE_HEAD_2) {
        break;
      }
    }
    if ((i + 1u) >= rx_acc_len) {
      // STX 없음 : 마지막 바이트가 0xFF 면 다음 바이트와 이어질 수 있으므로 남긴다
      i = (rx_acc_len > 0 && rx_acc[rx_acc_len - 1u] == YOUNGONE_HEAD_1) ? (uint16_t)(rx_acc_len - 1u) : rx_acc_len;
    }
    if (i > 0) {
      youngone_rx_stat.drop_bytes += i;
      rx_acc_drop(i);
    }

    // 2) 헤더 확보 ----------------------------------------------------------
    if (rx_acc_len < YOUNGONE_HEADER_LEN) {
      return;                                            // 더 받아야 함
    }

    if (rx_acc[PRODUCT_NAME_POS] != 'Y') {               // 가짜 STX
      youngone_rx_stat.pcode_err++;
      youngone_rx_stat.drop_bytes++;
      rx_acc_drop(1);
      continue;
    }

    frame_len = YOUNGONE_FRAME_LEN(rx_acc[DATA_LENGTH_POS]);
    if (frame_len < YOUNGONE_HEADER_LEN || frame_len > YOUNGONE_FRAME_MAX) {
      youngone_rx_stat.len_err++;
      youngone_rx_stat.drop_bytes++;
      rx_acc_drop(1);
      continue;
    }

    // 3) 프레임 전체 확보 ----------------------------------------------------
    if (rx_acc_len < frame_len) {
      return;                                            // 더 받아야 함
    }

    if (!youngone_crc_ok(rx_acc, frame_len)) {
      youngone_rx_stat.crc_err++;
      youngone_rx_stat.drop_bytes++;
      rx_acc_drop(1);                                    // 1byte만 버리고 재동기
      continue;
    }

    // 4) 정상 프레임 처리 ----------------------------------------------------
    ret = CA_youngone_receive_data_parser(rx_acc, frame_len);
    if (ret == NO_ERROR) {
      youngone_rx_stat.frame_ok++;
    } else {
      youngone_rx_stat.dispatch_err++;
    }

    rx_acc_drop(frame_len);                              // 뒤에 붙은 다음 프레임으로
  }
}

/*******************************************************************************
 * usart async receive data process (user_app_thread 에서 호출)
 * 링버퍼 → 누적 버퍼로 옮기면서 프레임을 처리한다.
 ******************************************************************************/
void CA_user_usart_receive_data_action(void)
{
  uint8_t c;
  bool    got = false;

  while (rx_ring_pop(&c)) {
    got = true;

    if (rx_acc_len >= sizeof(rx_acc)) {                  // 이론상 발생하지 않음 (frame_len <= 버퍼)
      youngone_rx_stat.drop_bytes++;
      rx_acc_drop(1);
    }
    rx_acc[rx_acc_len++] = c;

    // 버퍼가 프레임 최대 길이에 가까우면 그때그때 처리해서 공간 확보
    if (rx_acc_len >= YOUNGONE_HEADER_LEN) {
      youngone_framer_run();
    }
  }

  if (got) {
    rx_idle_tick = 0;
    youngone_framer_run();
  }
}

/*******************************************************************************
 * 50ms 주기 호출 (ulp_timer_event_action_process 에서)
 * 미완성 프레임이 일정 시간 정체되면 1byte 버리고 재동기한다.
 * (Length 가 깨져서 실제보다 길게 읽힌 경우 등)
 ******************************************************************************/
void youngone_rx_tick_50ms(void)
{
  if (rx_acc_len == 0) {
    rx_idle_tick = 0;
    return;
  }

  if (++rx_idle_tick >= YOUNGONE_RX_TIMEOUT_TICKS) {
    rx_idle_tick = 0;
    youngone_rx_stat.timeout_resync++;
    youngone_rx_stat.drop_bytes++;
    rx_acc_drop(1);
    youngone_framer_run();
  }
}




/*******************************************************************************
 * USART Example Initialization function
 ******************************************************************************/
void usart_async_init(void)
{
  sl_status_t status;
  sl_si91x_usart_control_config_t usart_config;

  // [FIX-1] 기존 코드는 NON_UC_DEFAULT_CONFIG == 0 이라 usart_config가 초기화되지 않은
  //         스택 값 그대로 sl_si91x_usart_set_configuration()에 전달되었음.
  //         항상 0으로 클리어 후 명시적으로 설정한다.
  memset(&usart_config, 0, sizeof(usart_config));
  usart_config.baudrate      = USART_BAUDRATE;
  usart_config.mode          = SL_USART_MODE_ASYNCHRONOUS;
  usart_config.parity        = SL_USART_NO_PARITY;
  usart_config.stopbits      = SL_USART_STOP_BITS_1;
  usart_config.hwflowcontrol = SL_USART_FLOW_CONTROL_NONE;
  usart_config.databits      = SL_USART_DATA_BITS_8;
  usart_config.misc_control  = SL_USART_MISC_CONTROL_NONE;
  usart_config.usart_module  = USART_0;
  usart_config.config_enable = ENABLE;
  usart_config.synch_mode    = DISABLE;

  sl_si91x_usart_control_config_t get_config;

  do {
    // Initialize the UART
    status = sl_si91x_usart_init(USART_0, &usart_handle);
    if (status != SL_STATUS_OK) {
      DEBUGOUT("sl_si91x_usart_initialize: Error Code : %lu \r\n", status);
      break;
    }

    DEBUGOUT("USART initialization is successful \n");
    // Configure the USART configurations
    status = sl_si91x_usart_set_configuration(usart_handle, &usart_config);
    if (status != SL_STATUS_OK) {
      DEBUGOUT("sl_si91x_usart_set_configuration: Error Code : %lu \r\n", status);
      break;
    }
    DEBUGOUT("USART configuration is successful \n");

    // Register user callback function
    status = sl_si91x_usart_multiple_instance_register_event_callback(USART_0, usart_callback_event);
    if (status != SL_STATUS_OK) {
      DEBUGOUT("sl_si91x_usart_register_event_callback: Error Code : %lu \r\n", status);
      break;
    }


    DEBUGOUT("USART user event callback registered successfully \r\n");
    sl_si91x_usart_get_configurations(USART_0, &get_config);
    DEBUGOUT("Baud Rate = %ld \n", get_config.baudrate);

  } while (false);

  set_usart_receive_data_callback();                                          // setup usart data receive callback
}

/*******************************************************************************
 * Example sticking function
 ******************************************************************************/
void set_usart_receive_data_callback(void)
{
  sl_status_t status;

  status = sl_si91x_usart_async_receive_data(usart_handle, usart_data_in, 1);

  if(status!=SL_STATUS_OK) {

  }
}
/*******************************************************************************
 * usart async receive data process
 ******************************************************************************/
void user_usart_receive_data_action(void)
{
#if DEBUG_ASYNC_MSG
  DEBUGOUT("user_usart_receive_data_action: %d\r\n", user_usart_event.read_len);
#endif

  youngone_receive_data_parser(user_usart_event.read_buff, user_usart_event.read_len);
  user_usart_event.read_len=0;
}


/*******************************************************************************
 * Callback function triggered on data Transfer and reception
 ******************************************************************************/
void usart_callback_event(uint32_t event)
{
  uint8_t c;

  switch (event) {
    case SL_USART_EVENT_SEND_COMPLETE:
      usart_send_complete = true;
      DEBUGOUT("SL_USART_EVENT_SEND_COMPLETE \r\n");

      break;
    case SL_USART_EVENT_RECEIVE_COMPLETE:
      c = usart_data_in[0];
      user_usart_event.read_buff[user_usart_event.read_len++] = c;
      user_usart_event.read_len%=USART_BUFF_SIZE;

      user_usart_event.read_map=SET_USART_EVENT;
      user_usart_event.read_tmout=USART_TMOUT;

      set_usart_receive_data_callback();
      break;

    case SL_USART_EVENT_TRANSFER_COMPLETE:
      usart_transfer_complete = true;
      DEBUGOUT("SL_USART_EVENT_TRANSFER_COMPLETE \r\n");
      break;
  }
}

/*******************************************************************************
 * 4 byte -> unsigned int
 ******************************************************************************/
uint16_t make_Word(uint8_t *acBuff, uint8_t i)
{
  uint16_t retVal = 0;

#if 1
  retVal|= (uint16_t)(acBuff[i+1]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint16_t)(acBuff[i]&0xFF);
#else
  retVal|= (uint16_t)(acBuff[i]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint16_t)(acBuff[i+1]&0xFF);
#endif

  return retVal;
}

/*******************************************************************************
 * 4 byte -> unsigned int
 ******************************************************************************/
uint32_t make_DWord(uint8_t *acBuff, uint8_t i)
{
  uint32_t retVal = 0;

#if 1
  retVal = (uint32_t)(acBuff[i+3]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint32_t)(acBuff[i+2]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint32_t)(acBuff[i+1]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint32_t)(acBuff[i]&0xFF);
#else
  retVal = (uint32_t)(acBuff[i]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint32_t)(acBuff[i+1]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint32_t)(acBuff[i+2]&0xFF);
  retVal = retVal<<8;
  retVal|= (uint32_t)(acBuff[i+3]&0xFF);

#endif

  return retVal;
}


/*******************************************************************************
 * youngone data CRC checksum
 ******************************************************************************/
uint16_t youngone_checksum_calculation(uint8_t *payload, uint8_t length)
{
  uint8_t i, j;
  uint32_t temp, temp2, flag;

  temp = 0xFFFF;
  for(i=0;i<length;i++) {
      temp = temp^payload[i];

      for(j=1;j<=8;j++) {
          flag = temp&0x0001;
          temp>>=1;
          if(flag)
            temp^=0xA001;
      }
  }

  temp2 = temp>>8;
  temp  = (temp<<8) | temp2;
  temp &= 0xFFFF;

  return temp;
}


/*******************************************************************************
 * 수신된 센서 정보를 비교 하는 부분
 ******************************************************************************/
char sensor_info_equal_mem(const sensor_info_t *a, const sensor_info_t *b)
{
  return (memcmp(a, b, sizeof(sensor_info_t)) == 0);
}


#define TEMP_THRESHOLD  2                  // 허용 온도 차이
static inline char is_temp_changed(uint8_t a, uint8_t b)
{
    return (abs((int)a - (int)b) > TEMP_THRESHOLD);
}



char sensor_info_changed(const sensor_info_t *a, const sensor_info_t *b)
{
  if(is_temp_changed(a->ambient_1_Temp, b->ambient_1_Temp))   return 1;
  if(is_temp_changed(a->ambient_2_Temp, b->ambient_2_Temp))   return 1;
  if(is_temp_changed(a->cold_water_Temp, b->cold_water_Temp)) return 1;
  if(is_temp_changed(a->warm_water_Temp, b->warm_water_Temp)) return 1;

  if(a->AF_NTU != b->AF_NTU)  return 1;
  if(a->BF_NTU != b->BF_NTU)  return 1;
  if(a->water_Quality != b->water_Quality)  return 1;
  if(a->flow_value != b->flow_value)  return 1;

  return 0;
}


/*******************************************************************************
 * [FIX-4] 제어보드 누적 카운터 → 통신보드 누계 반영 (증분 방식)
 *
 *  - 부팅 후 첫 수신값은 기준값(baseline)으로만 사용하고 누계에는 더하지 않는다.
 *    (제어보드 카운터는 통신보드 리셋과 무관하게 유지된다는 전제.
 *     통신보드가 꺼져 있던 동안의 증분까지 반영해야 한다면 이 정책을 바꿔야 함)
 *  - 수신값이 이전값보다 작아지면 제어보드 카운터가 리셋된 것으로 보고
 *    0부터 다시 증가한 값(=수신값)을 증분으로 더한다.
 *    (자정 0x07 초기화 명령 이후 이 경로를 탄다)
 ******************************************************************************/
typedef struct {
  uint32_t prev;
  bool     valid;
} counter_acc_t;

static counter_acc_t cold_kWh_acc;
static counter_acc_t warm_kWh_acc;
static counter_acc_t run_time_acc;

static void accumulate_counter(counter_acc_t *acc, uint32_t *total, uint32_t rx)
{
  uint32_t delta;

  if (acc->valid) {
    delta = (rx >= acc->prev) ? (rx - acc->prev) : rx;   // 감소 → 카운터 리셋으로 간주
    *total += delta;
  }

  acc->prev  = rx;
  acc->valid = true;
}


/*******************************************************************************
 * youngone protocol parser
 ******************************************************************************/
int8_t youngone_receive_data_parser(uint8_t *receive_buff, const uint8_t receive_size)
{
  uint8_t command_name;
  uint8_t data_length;
  uint16_t read_checksum = 0;
  uint16_t calc_checksum = 0;

  tyBITS bit_state;

  sensor_info_t s_info;

  uint16_t cold_amount = 0;
  uint16_t warm_amount = 0;
  uint16_t spkl_amount = 0;

  uint32_t cold_kWh = 0;
  uint32_t warm_kWh = 0;
  uint32_t run_time = 0;

#if 0
  for(int i=0;i<receive_size;i++)
    LOG_PRINT("[0x%02X]", receive_buff[i]);

  LOG_PRINT("\r\n");
#endif

  command_name = receive_buff[COMMAND_POS];

  if((receive_buff[0]!=YOUNGONE_HEAD_1)||(receive_buff[1]!=YOUNGONE_HEAD_2)) {
//    youngwon_receive_response(command_name, 0x06);        // STX ERROR
    return STX_ERROR;
  }

  memset(pYoungWon->basic_info.p_name, 0, sizeof(pYoungWon->basic_info.p_name));
  strncpy((char *)pYoungWon->basic_info.p_name, (char *)&receive_buff[PRODUCT_NAME_POS], 6);

  if(pYoungWon->basic_info.p_name[0] != 'Y') {
//    youngwon_receive_response(command_name, 0x07);        // Product Code Error
    return PRODUCT_CODE_ERROR;
  }

  data_length = receive_buff[DATA_LENGTH_POS];

  read_checksum = make_Word((uint8_t *)receive_buff, CHECKSUM_POS);

  receive_buff[CHECKSUM_POS] = 0;
  receive_buff[CHECKSUM_POS+1] = 0;
  //calc_checksum = youngone_checksum_calculation((uint8_t *)receive_buff, receive_size);
  calc_checksum = youngone_checksum_calculation((uint8_t *)receive_buff, data_length);

#if DEBUG_ASYNC_MSG
  LOG_PRINT(" checksum : [%d] / [%d] ==> [%d][%d]\r\n", read_checksum, calc_checksum, data_length, receive_size);
#endif

#if 1
  if(read_checksum != calc_checksum) {
//    youngwon_receive_response(command_name, 0x01);        // CRC Error
    return CRC_FAILED;
  }
#endif

#if DEBUG_ASYNC_MSG
  LOG_PRINT(" command_name : [%d]\r\n", command_name);
#endif

  switch(command_name) {
    case BASIC_INFORMATION:
      pYoungWon->basic_info.ver_main = receive_buff[PAYLOAD_START_POS];
      pYoungWon->basic_info.ver_sub1 = receive_buff[PAYLOAD_START_POS+1];
      pYoungWon->basic_info.ver_sub2 = receive_buff[PAYLOAD_START_POS+2];

      pYoungWon->basic_info.device_id = make_Word(receive_buff, PAYLOAD_START_POS+3);

      pYoungWon->basic_info.year = receive_buff[PAYLOAD_START_POS+5];
      pYoungWon->basic_info.month = receive_buff[PAYLOAD_START_POS+6];
      pYoungWon->basic_info.day = receive_buff[PAYLOAD_START_POS+7];

#if DEBUG_ASYNC_MSG
      LOG_PRINT("version : [%d].[%d].[%d]\r\n", pYoungWon->basic_info.ver_main, pYoungWon->basic_info.ver_sub1, pYoungWon->basic_info.ver_sub2);
      LOG_PRINT("device ID : [%ld]\r\n", pYoungWon->basic_info.device_id);
      LOG_PRINT("date : [%d]-[%d]-[%d]\r\n", pYoungWon->basic_info.year, pYoungWon->basic_info.month, pYoungWon->basic_info.day);
#endif
      break;

    case STATE_INFORMATION:
      bit_state.bAll = receive_buff[PAYLOAD_START_POS];
      if(bit_state.bAll != device_bit_state.bAll) {
          device_bit_state.bAll = bit_state.bAll;
//          SET_RCV_STATUS_INFO(1);
          SET_WS_STATUS_INFO(1);
      }

      bit_state.bAll = receive_buff[PAYLOAD_START_POS+1];
      if(bit_state.bAll != module_bit_state.bAll) {
          module_bit_state.bAll = bit_state.bAll;
//          SET_RCV_STATUS_INFO(1);
        SET_WS_STATUS_INFO(1);
      }

      bit_state.bAll = receive_buff[PAYLOAD_START_POS+2];
      if(bit_state.bAll != module_bit_error.bAll) {
          module_bit_error.bAll = bit_state.bAll;
//          SET_RCV_STATUS_INFO(1);
        SET_WS_STATUS_INFO(1);
      }

      bit_state.bAll = receive_buff[PAYLOAD_START_POS+3];
      if(bit_state.bAll != active_bit_state.bAll) {
          active_bit_state.bAll = bit_state.bAll;
//          SET_RCV_STATUS_INFO(1);
        SET_WS_STATUS_INFO(1);
      }

#if DEBUG_ASYNC_MSG
      LOG_PRINT("State Info : [%02X] / [%02X] / [%02X] / [%02X]\r\n",
                device_bit_state.bAll, module_bit_state.bAll,
                module_bit_error.bAll, active_bit_state.bAll);

      LOG_PRINT("=> [%d] [%d] [%d] [%d] [%d] [%d] [%d] [%d] \r\n",  GET_HOT_WATER_SWITCH(),
                GET_CARBON_GAS_STATE(), GET_CARBON_GAS_LEAK(), GET_CARBON_GAS_LEVEL(),
                GET_COMPRESSOR_MOTOR(), GET_COLD_WATER_TEMP(), GET_COLD_WATER_LEVEL(), GET_COOLING_STATE());
#endif

      break;

    case SENSOR_INFORMATION:

      s_info.cold_water_Temp = receive_buff[PAYLOAD_START_POS];
      s_info.ambient_1_Temp = receive_buff[PAYLOAD_START_POS+1];
      s_info.ambient_2_Temp = receive_buff[PAYLOAD_START_POS+2];
      s_info.warm_water_Temp = receive_buff[PAYLOAD_START_POS+3];

      s_info.BF_NTU = receive_buff[PAYLOAD_START_POS+4];
      s_info.AF_NTU = receive_buff[PAYLOAD_START_POS+5];
      s_info.water_Quality = receive_buff[PAYLOAD_START_POS+6];

//      s_info.flow_value = receive_buff[PAYLOAD_START_POS+7];
      s_info.flow_value = 40;           // 40 x 10 = 400ml/min

      if(sensor_info_changed(&pYoungWon->sensor_info, &s_info)) {           // 온도는 1~2도 변경은 데이터 전송을 하지 않는다...
          pYoungWon->sensor_info = s_info;
//          SET_RCV_SENSOR_INFO(1);                                           // 센서 정보 업데이트 해야 한다...
          SET_WS_SENSOR_INFO(1);
      }

#if DEBUG_ASYNC_MSG
      LOG_PRINT("SENSOR : [%d][%d][%d][%d] / [%d]\r\n", pYoungWon->sensor_info.cold_water_Temp,
                pYoungWon->sensor_info.ambient_1_Temp, pYoungWon->sensor_info.ambient_2_Temp,
                pYoungWon->sensor_info.warm_water_Temp, s_info.flow_value);
#endif
      break;

    case SOFTWARE_VERIFICATION:

#if 0
      LOG_PRINT("SOFTWARE : [%02x][%02x][%02x][%02x]\r\n", receive_buff[PAYLOAD_START_POS],
                receive_buff[PAYLOAD_START_POS+1],receive_buff[PAYLOAD_START_POS+2],receive_buff[PAYLOAD_START_POS+3]);
#endif

      cold_kWh = make_DWord(receive_buff, PAYLOAD_START_POS);
      warm_kWh = make_DWord(receive_buff, PAYLOAD_START_POS+4);
      run_time = make_DWord(receive_buff, PAYLOAD_START_POS+8);
      valve_bit_state.bAll = receive_buff[PAYLOAD_START_POS+12];


      // [FIX-4] 기존 로직은 제어보드 카운터가 리셋된 이후 "수신값 전체"를 매번 더해서 이중 합산이 발생했음.
      //         (예: flash=1000, 리셋 후 5 → 1005, 다음 10 → 1015 / 정답 1010)
      //         이전 수신값과의 증분(delta)만 누적하도록 변경.
      if(pYoungWon->valve_info.cold_Watt_hr!=cold_kWh) {
          pYoungWon->valve_info.cold_Watt_hr = cold_kWh;
          SET_WS_VERIFICATION(1);
      }
      accumulate_counter(&cold_kWh_acc, &user_flash_info.cold_water_kWh, cold_kWh);

      if(pYoungWon->valve_info.warm_Watt_hr!=warm_kWh) {
          pYoungWon->valve_info.warm_Watt_hr = warm_kWh;
          SET_WS_VERIFICATION(1);
      }
      accumulate_counter(&warm_kWh_acc, &user_flash_info.warm_water_kWh, warm_kWh);

      if(pYoungWon->valve_info.life_filter!=run_time) {
          pYoungWon->valve_info.life_filter = run_time;
      }
      accumulate_counter(&run_time_acc, &user_flash_info.valve_flow_run_time, run_time);

#if DEBUG_ASYNC_MSG
      LOG_PRINT("SOFTWARE : [%ld][%ld][%ld][%02X]\r\n", pYoungWon->valve_info.cold_Watt_hr,
                pYoungWon->valve_info.warm_Watt_hr, pYoungWon->valve_info.life_filter, valve_bit_state.bAll);
#endif

      break;

    case WATER_DISCHARGE_AMOUNT:
      cold_amount = make_Word(receive_buff, PAYLOAD_START_POS);
      warm_amount = make_Word(receive_buff, PAYLOAD_START_POS+2);
      spkl_amount = make_Word(receive_buff, PAYLOAD_START_POS+4);

      pYoungWon->water_amount.cold_water+= cold_amount;
      pYoungWon->water_amount.warm_water+= warm_amount;
      pYoungWon->water_amount.sparkling += spkl_amount;

      SET_RCV_WATER_AMOUNT(1);                                  // 출수량은 변경 된 뒤 최소 30분
      water_amount_time = 60*30;                                // 60 sec * 30 = 30min

      break;

    default:
//      youngwon_receive_response(command_name, 0x02);        // UNKNOWN CMD
      return UNKNOWN_CMD;
      break;

  }

//  youngwon_receive_response(command_name, 0x00);        // No Error
  return NO_ERROR;
}

/*******************************************************************************
 * basic information request (Communication Board -> Control Board)
 ******************************************************************************/
void youngwon_information_request(uint8_t cmd_ID)
{
  int8_t    send_count = 0;
  uint8_t   usart_data_out[64];
  uint8_t   send_len = 0;
  uint16_t  cal_crc16;
  sl_status_t status;

  send_len = 0;
  usart_data_out[send_len++] = 0xFF;
  usart_data_out[send_len++] = 0x81;
  strncpy((char *)&usart_data_out[PRODUCT_NAME_POS], (char *)pYoungWon->basic_info.p_name, 6);
  send_len+=6;

  usart_data_out[send_len++] = cmd_ID+0x10;
  usart_data_out[send_len++] = 0x00;       // status(No Reply)
  usart_data_out[send_len++] = 0x00;       // Length
  usart_data_out[send_len++] = 0x00;       // Reserve
  usart_data_out[send_len++] = 0x00;       // CHECK SUM
  usart_data_out[send_len++] = 0x00;

  usart_data_out[DATA_LENGTH_POS] = send_len;
  cal_crc16 = youngone_checksum_calculation((uint8_t *)usart_data_out, send_len);
  usart_data_out[CHECKSUM_POS]  = make_Byte(cal_crc16, 0);
  usart_data_out[CHECKSUM_POS+1]= make_Byte(cal_crc16, 1);

  usart_send_complete = false;
  send_count = 5;                   // 데이터 전송 실패 할 경우 5회 까지 시도를 한다...
  do {
    status = sl_si91x_usart_send_data(usart_handle, usart_data_out, send_len);
    if(status==SL_STATUS_OK) {
        break;
    }
    else {
        osDelay(100);
    }
  } while(send_count-->0);

#if DEBUG_ASYNC_PACKET
  printf("send_len : %d \r\n",  send_len);

  for(int i=0;i<send_len;i++) {
      printf("%02x ",  usart_data_out[i]);
  }
#endif
}

/*******************************************************************************
 * youngwon_receive_response (Communication Board -> Control Board)
 ******************************************************************************/
void youngwon_receive_response(uint8_t cmd_ID, uint8_t err_code)
{
  int8_t    send_count = 0;
  uint8_t   send_len = 0;
  uint16_t  cal_crc16;
  sl_status_t status;

  memset(usart_data_out, 0, sizeof(usart_data_out));

  send_len = 0;
  usart_data_out[send_len++] = 0xFF;
  usart_data_out[send_len++] = 0x81;
  strncpy((char *)&usart_data_out[PRODUCT_NAME_POS], (char *)pYoungWon->basic_info.p_name, 6);
  send_len+=6;

  usart_data_out[send_len++] = cmd_ID;
  usart_data_out[send_len++] = 0x00;       // status(No Reply)
  usart_data_out[send_len++] = 0x04;       // Length
  usart_data_out[send_len++] = 0x00;       // Reserve
  usart_data_out[send_len++] = 0x00;       // CHECK SUM
  usart_data_out[send_len++] = 0x00;

//------------------------------------------------------------------------------

  usart_data_out[send_len++] = err_code;          // No Error

  usart_data_out[send_len++] = pYoungWon->basic_info.ver_main;
  usart_data_out[send_len++] = pYoungWon->basic_info.ver_sub1;
  usart_data_out[send_len++] = pYoungWon->basic_info.ver_sub2;

  usart_data_out[send_len++] = wlan_bit_state.bAll;


  usart_data_out[DATA_LENGTH_POS] = send_len;
  cal_crc16 = youngone_checksum_calculation((uint8_t *)usart_data_out, send_len);
  usart_data_out[CHECKSUM_POS]  = make_Byte(cal_crc16, 0);
  usart_data_out[CHECKSUM_POS+1]= make_Byte(cal_crc16, 1);

  usart_send_complete = false;
  send_count = 5;                   // 데이터 전송 실패 할 경우 5회 까지 시도를 한다...
  do {
    status = sl_si91x_usart_send_data(usart_handle, usart_data_out, send_len);
    if(status==SL_STATUS_OK) {
        break;
    }
    else {
        osDelay(100);
    }
  } while(send_count-->0);

#if DEBUG_ASYNC_PACKET
  printf("send_len : %d =>",  send_len);
  for(int i=0;i<send_len;i++) {
      printf("%02x ",  usart_data_out[i]);
  }
  printf("\r\n");
#endif
}


/*******************************************************************************
 * status information protocol (Communication Board -> Control Board)
 ******************************************************************************/
void youngwon_water_out_control_setup(uint8_t water_mode)
{
  uint8_t   send_len = 0;
  int8_t    send_loop= 5;
  uint16_t  cal_crc16;
  sl_status_t status;

  memset(usart_data_out, 0, sizeof(usart_data_out));

  send_len = 0;
  usart_data_out[send_len++] = 0xFF;
  usart_data_out[send_len++] = 0x81;
  strncpy((char *)&usart_data_out[PRODUCT_NAME_POS], (char *)pYoungWon->basic_info.p_name, 6);
  send_len+=6;

  usart_data_out[send_len++] = 0x21;       // Water Control
  usart_data_out[send_len++] = 0x00;       // status(No Reply)
  usart_data_out[send_len++] = 0x00;       // Length
  usart_data_out[send_len++] = 0x00;       // Reserve
  usart_data_out[send_len++] = 0x00;       // CHECK SUM
  usart_data_out[send_len++] = 0x00;

//------------------------------------------------------------------------------
  if(water_mode == COLD_WATER_MODE) {
    usart_data_out[send_len++] = COLD_WATER_MODE;     //
    if(user_flash_info.water_flow[WATER_NAME_COLD] == 250) {
      usart_data_out[send_len++] = 1;
    } else if(user_flash_info.water_flow[WATER_NAME_COLD] == 550) {
      usart_data_out[send_len++] = 2;
    } else {
        usart_data_out[send_len++] = 0;
        user_flash_info.water_flow[WATER_NAME_COLD] = 120;
    }
    usart_data_out[send_len++] = user_flash_info.water_temp[WATER_NAME_COLD];
  }
  else if(water_mode == HOT_WATER_MODE) {
    usart_data_out[send_len++] = HOT_WATER_MODE;     //
    if(user_flash_info.water_flow[WATER_NAME_HOT] == 250) {
      usart_data_out[send_len++] = 1;
    }
    else if(user_flash_info.water_flow[WATER_NAME_HOT] == 550) {
      usart_data_out[send_len++] = 2;
    }
    else if(user_flash_info.water_flow[WATER_NAME_HOT] == 1000) {
      usart_data_out[send_len++] = 3;
    }
    else {
        usart_data_out[send_len++] = 0;
        user_flash_info.water_flow[WATER_NAME_HOT] = 120;
    }
    usart_data_out[send_len++] = user_flash_info.water_temp[WATER_NAME_HOT];
  }
  else {
    usart_data_out[send_len++] = SPARKLING_MODE;     //
    if(user_flash_info.water_flow[WATER_SPARKLING] == 250) {
      usart_data_out[send_len++] = 1;
    }
    else if(user_flash_info.water_flow[WATER_SPARKLING] == 550) {
      usart_data_out[send_len++] = 2;
    }
    else if(user_flash_info.water_flow[WATER_SPARKLING] == 1000) {
      usart_data_out[send_len++] = 3;
    }
    else {
        usart_data_out[send_len++] = 0;
        user_flash_info.water_flow[WATER_SPARKLING] = 120;
    }
    usart_data_out[send_len++] = user_flash_info.water_temp[WATER_SPARKLING];
  }

  usart_data_out[DATA_LENGTH_POS] = send_len;                    // DATA LENGTH
  cal_crc16 = youngone_checksum_calculation((uint8_t *)usart_data_out, send_len);
  usart_data_out[CHECKSUM_POS]  = make_Byte(cal_crc16, 0);
  usart_data_out[CHECKSUM_POS+1]= make_Byte(cal_crc16, 1);

  usart_send_complete = false;
  do {
    status = sl_si91x_usart_send_data(usart_handle, usart_data_out, send_len);
    if(status==SL_STATUS_OK) {
        break;
    }
    else {
        osDelay(100);
    }
  } while(send_loop-->0);

#if DEBUG_ASYNC_PACKET
  printf("send_len : %d =>",  send_len);
  for(int i=0;i<send_len;i++) {
      printf("%02x ",  usart_data_out[i]);
  }
  printf("\r\n");
#endif
}


/*******************************************************************************
 * status information protocol (Communication Board -> Control Board)
 ******************************************************************************/
void youngwon_recipe_control_setup(void)
{
  uint8_t   send_len = 0;
  uint8_t   send_loop= 0;

  uint16_t  cal_crc16;
  sl_status_t status;

  memset(usart_data_out, 0, sizeof(usart_data_out));

  send_len = 0;
  usart_data_out[send_len++] = 0xFF;
  usart_data_out[send_len++] = 0x81;
  strncpy((char *)&usart_data_out[PRODUCT_NAME_POS], (char *)pYoungWon->basic_info.p_name, 6);
  send_len+=6;

  usart_data_out[send_len++] = 0x22;       // Sparkling
  usart_data_out[send_len++] = 0x00;       // status(No Reply)
  usart_data_out[send_len++] = 0x00;       // Length
  usart_data_out[send_len++] = 0x00;       // Reserve
  usart_data_out[send_len++] = 0x00;       // CHECK SUM
  usart_data_out[send_len++] = 0x00;

//------------------------------------------------------------------------------
//  RECIPE는 저장 하지 않고 웹에서 변경 한 상태를 그대로 전달만 한다..
//------------------------------------------------------------------------------
  usart_data_out[send_len++] = (uint8_t)((float)user_info.water_recipe.cold_flow/10.);
  usart_data_out[send_len++] = (uint8_t)((float)user_info.water_recipe.warm_flow/10.);
  usart_data_out[send_len++] = (uint8_t)((float)user_info.water_recipe.sparkling/10.);

  usart_data_out[DATA_LENGTH_POS] = send_len;     // DATA LENGTH
  cal_crc16 = youngone_checksum_calculation((uint8_t *)usart_data_out, send_len);
  usart_data_out[CHECKSUM_POS]  = make_Byte(cal_crc16, 0);
  usart_data_out[CHECKSUM_POS+1]= make_Byte(cal_crc16, 1);

  usart_send_complete = false;
  send_loop = 5;                   // 데이터 전송 실패 할 경우 5회 까지 시도를 한다...
  do {
    status = sl_si91x_usart_async_send_data(usart_handle, usart_data_out, send_len);
    if(status==SL_STATUS_OK) {
        break;
    }
    else {
        osDelay(100);
    }
  } while(send_loop-->0);

  #if DEBUG_ASYNC_PACKET
  printf("send_len : %d =>",  send_len);
  for(int i=0;i<send_len;i++) {
      printf("%02x ",  usart_data_out[i]);
  }
  printf("\r\n");
#endif
}


/*******************************************************************************
 * status information protocol (Communication Board -> Control Board)
 ******************************************************************************/
void youngwon_software_verification_initial(uint8_t init_cmd)
{
  uint8_t   send_len = 0;
  uint8_t   send_loop= 5;

  uint16_t  cal_crc16;
  sl_status_t status;

  memset(usart_data_out, 0, sizeof(usart_data_out));

  send_len = 0;
  usart_data_out[send_len++] = 0xFF;
  usart_data_out[send_len++] = 0x81;
  strncpy((char *)&usart_data_out[PRODUCT_NAME_POS], (char *)pYoungWon->basic_info.p_name, 6);
  send_len+=6;

  usart_data_out[send_len++] = 0x25;       // Intial
  usart_data_out[send_len++] = 0x00;       // status(No Reply)
  usart_data_out[send_len++] = 0x00;       // Length
  usart_data_out[send_len++] = 0x00;       // Reserve
  usart_data_out[send_len++] = 0x00;       // CHECK SUM
  usart_data_out[send_len++] = 0x00;

//------------------------------------------------------------------------------
//  현재 날짜 & 시간 과 초기화 상태
//------------------------------------------------------------------------------
  usart_data_out[send_len++] = user_calendar.Year;
  usart_data_out[send_len++] = user_calendar.Month;
  usart_data_out[send_len++] = user_calendar.Day;

  usart_data_out[send_len++] = user_calendar.Hour;
  usart_data_out[send_len++] = user_calendar.Minute;
  usart_data_out[send_len++] = init_cmd;

  usart_data_out[DATA_LENGTH_POS] = send_len;     // DATA LENGTH
  cal_crc16 = youngone_checksum_calculation((uint8_t *)usart_data_out, send_len);
  usart_data_out[CHECKSUM_POS]  = make_Byte(cal_crc16, 0);
  usart_data_out[CHECKSUM_POS+1]= make_Byte(cal_crc16, 1);

  usart_send_complete = false;

  do {
    status = sl_si91x_usart_async_send_data(usart_handle, usart_data_out, send_len);
    if(status==SL_STATUS_OK) {
        break;
    }
    else {
        osDelay(100);
    }
  } while(send_loop-->0);

#if DEBUG_ASYNC_PACKET
  printf("send_len : %d =>",  send_len);
  for(int i=0;i<send_len;i++) {
      printf("%02x ",  usart_data_out[i]);
  }
  printf("\r\n");
#endif
}


/*******************************************************************************
 *  설정된 출수를 100ms 간격으로 COntrol Board로 전송을 한다...
 *******************************************************************************/
void youngwon_send_water_flow_out_control(void)
{
  if(water_flow_out_flag == 0)
    return;

  switch(water_flow_out_step) {
    case 0:
      youngwon_water_out_control_setup(COLD_WATER_MODE);
      water_flow_out_step++;
      break;

    case 1:
      youngwon_water_out_control_setup(HOT_WATER_MODE);
      water_flow_out_step++;
      break;

    case 2:
      youngwon_water_out_control_setup(SPARKLING_MODE);
      water_flow_out_step = 0;
      water_flow_out_flag = 0;
      break;
    default:
      break;
  }
}

